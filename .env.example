# MasterFabric (mf-go) — required
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8080/graphql
NEXT_PUBLIC_MF_APP_API_KEY=
# Optional server-only alias:
# MF_APP_API_KEY=
# MF_GRAPHQL_URL=http://localhost:8080/graphql

# Sign in with GitHub uses mf-go (not this app’s own OAuth secrets):
#   1) In mf-go/.env set MF_CORE_GITHUB_CLIENT_ID + MF_CORE_GITHUB_CLIENT_SECRET
#      (or app_settings mf_core.github_oauth_source_app_id → a client app’s GitHub integration).
#   2) Restart mf-go, confirm: { mfCorePublicAuth { githubClientId } } is non-null.
#   3) On the GitHub OAuth App, add callback:
#        http://localhost:3020/auth/callback
#        (and production https://manifesto.masterfabric.co/auth/callback)
# Manifesto only redirects to GitHub using that public client id, then exchanges the code via mf-go loginWithGitHub.
